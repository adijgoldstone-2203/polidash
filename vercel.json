{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/2022/tiles/:path*",
      "destination": "https://elections.kaplanopensource.co.il/2022/tiles/:path*"
    },
    {
      "source": "/tiles/:path*",
      "destination": "https://elections.kaplanopensource.co.il/tiles/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
